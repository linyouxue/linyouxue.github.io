---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { about } from '../data/about';
import { site } from '../data/site';
import { pathFor, ui, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const copy = about[lang];
---
<BaseLayout lang={lang} title={t.about} description={copy.introduction}>
 <div class="about-surface">
  <header class="about-topbar">
    <a class="about-home" href={pathFor(lang)} aria-label={lang === 'en' ? 'Linyouxue — Home' : '林元靖 — 首页'}>
      <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m12 4-6 6 6 6" /></svg>
      {t.home}
    </a>
    <a class="about-contact-jump" href="#contact">{lang === 'en' ? 'Contact' : '联系'}</a>
    <LanguageSwitch lang={lang} alternatePath={pathFor(lang === 'en' ? 'zh' : 'en', '/about/')} />
  </header>
  <main class="about-document" id="main">
    <header class="about-identity">
      <img class="about-portrait" src="/assets/avatar.webp" alt={lang === 'en' ? 'Linyouxue’s avatar' : '林元靖的网头'} width="128" height="128" />
      <h1>{site.realName[lang]}</h1>
      <p class="about-handle">Linyouxue</p>
      <p class="about-affiliation-line">{copy.identity}</p>
    </header>
    <div class="about-introduction">
      <p>{copy.introduction}</p>
      <ul class="about-facts" aria-label={copy.quickFacts}>
        {copy.facts.map(fact => <li>{fact}</li>)}
      </ul>
    </div>
    <section class="about-section" aria-labelledby="questions-title">
      <h2 id="questions-title">{copy.questions}</h2>
      {copy.interests.map(interest => <div class="about-entry">
        <h3>{interest.title}</h3>
        <p>{interest.description}</p>
      </div>)}
    </section>
    <section class="about-section" aria-labelledby="education-title">
      <h2 id="education-title">{copy.education}</h2>
      <p class="about-education"><span>{copy.years}</span><span>{copy.university}</span></p>
      <p>{copy.degree}</p>
    </section>
    <section class="about-section" aria-labelledby="learning-title">
      <h2 id="learning-title">{copy.learning}</h2>
      {copy.practice.map(practice => <div class="about-entry">
        <h3>{practice.title}</h3>
        <p>{practice.description}</p>
      </div>)}
    </section>
    <section class="about-section" aria-labelledby="life-title">
      <h2 id="life-title">{copy.life}</h2>
      {copy.hobbies.map(hobby => <div class="about-entry">
        <h3>{hobby.title}</h3>
        <p>{hobby.description}</p>
      </div>)}
    </section>
    <section class="about-section about-connect" id="contact" tabindex="-1" aria-labelledby="contact-title">
      <h2 id="contact-title">{copy.connect}</h2>
      <SocialLinks lang={lang} variant="full" />
    </section>
  </main>
  <footer class="about-footer">
    <nav aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
      <a href={pathFor(lang, '/writing/')}>{t.writing}</a>
      <a href={pathFor(lang, '/work/')}>{t.work}</a>
      <a href={pathFor(lang, '/about/')} aria-current="page">{t.about}</a>
    </nav>
  </footer>
 </div>
</BaseLayout>

<style>
  @font-face {
    font-family: 'About Newsreader';
    src: url('/fonts/Newsreader-variable.ttf') format('truetype');
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
  }
  .about-surface {
    --about-paper: #f4f0e8;
    --about-ink: #292a25;
    --about-muted: #68665f;
    --about-accent: #9d432a;
    --about-line: #dcd5c9;
    --about-serif: 'About Newsreader', 'Noto Serif CJK SC', 'Songti SC', SimSun, serif;
    min-height: 100svh;
    background: var(--about-paper);
    color: var(--about-ink);
  }
  .about-topbar {
    width: min(1120px, calc(100% - 80px));
    margin-inline: auto;
    min-height: 92px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    color: var(--about-muted);
  }
  .about-home {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 9px;
    padding-block: 12px;
    font-size: 15px;
    text-decoration: none;
  }
  .about-contact-jump { padding: 12px; font-size: 14px; text-decoration: none; }
  .about-home:hover, .about-contact-jump:hover, .about-footer a:hover { color: var(--about-accent); }
  .about-contact-jump:hover { text-decoration: underline; }
  .about-topbar :global(.language-switch) { justify-self: end; gap: 12px; }
  .about-topbar :global(.language-switch [aria-current]) { color: var(--about-accent); }
  .about-topbar :global(.language-divider) { color: var(--about-muted); }
  .about-document {
    width: min(760px, calc(100% - 48px));
    margin: 12px auto 0;
    font: 21px/1.65 var(--about-serif);
  }
  .about-document h1, .about-document h2, .about-document h3 { font-family: var(--about-serif); }
  .about-identity { text-align: center; }
  .about-portrait {
    width: 128px;
    height: 128px;
    margin-inline: auto;
    border: 2px solid #ffffffdb;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 50%;
    background: #e6edf5;
  }
  .about-identity h1 { margin-top: 20px; font-size: 60px; font-weight: 550; line-height: 1.1; letter-spacing: -.035em; }
  .about-handle { margin-top: 5px; font: 17px/1.5 var(--sans); color: var(--about-muted); }
  .about-affiliation-line { margin-top: 10px; font-size: 20px; color: var(--about-muted); text-wrap: balance; }
  .about-introduction { margin-top: 42px; }
  .about-introduction > p { font-size: 23px; line-height: 1.6; }
  .about-facts { display: flex; flex-wrap: wrap; gap: 5px 0; list-style: none; margin: 17px 0 0; padding: 0; font: 15px/1.7 var(--sans); color: var(--about-muted); }
  .about-facts li:not(:last-child)::after { content: '·'; display: inline-block; margin-inline: 14px; }
  .about-section { margin-top: 36px; padding-top: 27px; border-top: 1px solid var(--about-line); }
  .about-section h2 { margin-bottom: 17px; font-size: 40px; font-weight: 550; line-height: 1.2; letter-spacing: -.025em; text-wrap: balance; }
  .about-section > p, .about-entry p { color: var(--about-muted); }
  .about-entry + .about-entry { margin-top: 26px; }
  .about-entry h3 { font-size: 25px; font-weight: 500; line-height: 1.4; color: var(--about-accent); }
  .about-entry p { margin-top: 2px; text-wrap: pretty; }
  .about-education { display: flex; flex-wrap: wrap; gap: 2px 18px; }
  .about-education span:first-child::after { content: '·'; display: inline-block; margin-left: 18px; }
  .about-connect :global(.social-links) { column-gap: 28px; row-gap: 2px; font: 16px/1.6 var(--sans); color: var(--about-accent); }
  .about-connect :global(.social-links a) { padding-block: 8px; }
  .about-connect :global(.social-links a:last-child) { order: -1; flex-basis: 100%; font-size: 18px; overflow-wrap: anywhere; }
  .about-connect :global(.social-links a:last-child svg) { display: none; }
  .about-connect { scroll-margin-top: 24px; }
  .about-footer { width: min(760px, calc(100% - 48px)); margin: 48px auto 0; padding: 25px 0 40px; border-top: 1px solid var(--about-line); color: var(--about-muted); font-size: 14px; }
  .about-footer nav { display: flex; flex-wrap: wrap; gap: 8px 26px; }
  .about-footer a { padding-block: 8px; text-decoration: none; }
  .about-footer a[aria-current] { color: var(--about-accent); }
  :global([lang='zh-CN']) .about-document { --about-muted: #504e48; font-size: 20px; line-height: 1.9; }
  :global([lang='zh-CN']) .about-introduction > p { font-size: 21px; line-height: 1.9; }
  :global([lang='zh-CN']) .about-identity h1 { letter-spacing: .06em; }
  :global([lang='zh-CN']) .about-section h2 { font-size: 34px; }
  :global([lang='zh-CN']) .about-entry h3 { font-size: 23px; color: #8e3d27; }
  :global([lang='zh-CN']) .about-introduction > p,
  :global([lang='zh-CN']) .about-section > p,
  :global([lang='zh-CN']) .about-entry p,
  :global([lang='zh-CN']) .about-entry h3 { -webkit-text-stroke: .12px currentColor; }
  @media (max-width: 600px) {
    .about-topbar { width: calc(100% - 48px); min-height: 72px; }
    .about-document { margin-top: 8px; font-size: 18px; line-height: 1.6; }
    .about-portrait { width: 112px; height: 112px; }
    .about-identity h1 { margin-top: 17px; font-size: 43px; }
    .about-handle { font-size: 15px; }
    .about-affiliation-line { font-size: 17px; line-height: 1.5; }
    .about-introduction { margin-top: 29px; }
    .about-introduction > p { font-size: 19px; }
    .about-facts { font-size: 13px; margin-top: 14px; }
    .about-facts li:not(:last-child)::after { margin-inline: 10px; }
    .about-section { margin-top: 28px; padding-top: 24px; }
    .about-section h2 { margin-bottom: 15px; font-size: 30px; line-height: 1.22; }
    .about-entry h3 { font-size: 22px; }
    .about-entry + .about-entry { margin-top: 24px; }
    .about-education { gap: 2px 12px; }
    .about-education span:first-child::after { margin-left: 12px; }
    .about-connect :global(.social-links a:last-child) { font-size: 17px; }
    .about-footer { margin-top: 35px; padding-bottom: 28px; }
    .about-footer nav { gap: 8px 22px; }
    :global([lang='zh-CN']) .about-document { font-size: 18px; line-height: 1.9; }
    :global([lang='zh-CN']) .about-introduction > p { font-size: 18px; }
    :global([lang='zh-CN']) .about-section h2 { font-size: 28px; }
    :global([lang='zh-CN']) .about-entry h3 { font-size: 21px; }
  }
</style>
