---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { pathFor, ui, type Lang } from '../lib/i18n';
import '../styles/cover.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
---
<BaseLayout lang={lang} title={site.name[lang]} kind="cover">
  <div class="galaxy-scene" aria-hidden="true">
    <div class="galaxy-background"></div>
    <div class="reading-shade"></div>
    <div class="entrance-veil"></div>
  </div>
  <div id="meteor-layer" aria-hidden="true"></div>
  <div id="star-cursor" aria-hidden="true"></div>
  <canvas id="cursor-tail" aria-hidden="true"></canvas>
  <header class="language-control">
    <LanguageSwitch lang={lang} alternatePath={pathFor(lang === 'en' ? 'zh' : 'en')} />
  </header>
  <main class="portal-stage" id="main">
    <section class="portal" aria-label={lang === 'en' ? 'Linyouxue’s personal homepage' : '林元靖的个人主页'}>
      <img class="avatar" src="/assets/avatar.webp" alt={lang === 'en' ? 'Linyouxue’s avatar' : '林元靖的网头'} width="110" height="110" fetchpriority="high" />
      <h1>{site.name[lang]}</h1>
      <p class="subtitle">{site.tagline[lang]}</p>
      <div class="divider" aria-hidden="true"></div>
      <p class="bio">{site.bio[lang].split('\n').map(line => <span>{line}</span>)}</p>
      <nav class="main-navigation" aria-label={lang === 'en' ? 'Main navigation' : '主导航'}>
        <a href={pathFor(lang)} aria-current="page">{t.home}</a>
        <a href={pathFor(lang, '/writing/')}>{lang === 'en' ? 'Blog' : '博客'}</a>
        <a href={pathFor(lang, '/work/')}>{lang === 'en' ? 'Research' : t.work}</a>
        <a href={pathFor(lang, '/about/')}>{t.about}</a>
      </nav>
      <SocialLinks lang={lang} variant="icons" />
    </section>
  </main>
  <div class="cover-bottom-space" aria-hidden="true"></div>
  <script>
    import '../scripts/cover';
  </script>
</BaseLayout>
