---
import { site } from '../data/site';
import { ui, type Lang } from '../lib/i18n';
interface Props { lang: Lang; variant?: 'compact' | 'full' | 'icons'; }
const { lang, variant = 'compact' } = Astro.props;
const xiaohongshu = lang === 'en' ? 'Xiaohongshu' : '小红书';
const email = variant === 'full' ? site.email : lang === 'en' ? 'Email' : '邮箱';
---
<nav class:list={['social-links', { 'social-links-full': variant === 'full' }]} aria-label={ui[lang].socialLabel}>
  <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.55.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.3-3.76-1.3-.51-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.6 1.21 3.24.92.1-.72.39-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.43.11-2.97 0 0 .94-.3 3.06 1.14a10.7 10.7 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.69.12 2.97.72.78 1.14 1.78 1.14 3 0 4.27-2.6 5.22-5.09 5.49.4.34.75 1.02.75 2.06v3.1c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z" /></svg>
    {variant !== 'icons' && <span>GitHub</span>}
  </a>
  <a href={site.xiaohongshu} target="_blank" rel="noreferrer" aria-label={xiaohongshu} title={xiaohongshu}>
    <span class="xiaohongshu-mark" aria-hidden="true"></span>
    {variant !== 'icons' && <span>{xiaohongshu}</span>}
  </a>
  <a href={`mailto:${site.email}`} aria-label={email} title={site.email}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="1" /><path d="m3 5 9 8 9-8" /></svg>
    {variant !== 'icons' && <span>{email}</span>}
  </a>
</nav>
