---
import { site } from '../data/site';
import { ui, type Lang } from '../lib/i18n';
interface Props { lang: Lang; variant?: 'compact' | 'full'; }
const { lang, variant = 'compact' } = Astro.props;
---
<nav class:list={['social-links', { 'social-links-full': variant === 'full' }]} aria-label={ui[lang].socialLabel}>
  <a href={site.github} target="_blank" rel="noreferrer">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21v-3.5c-4 .8-4-2-5-2.5m13 6v-3.5c0-1-.3-1.8-.8-2.3 2.8-.4 5.8-1.4 5.8-6.2A4.8 4.8 0 0 0 19.5 5c.2-.9.1-2-.3-3 0 0-1.2-.4-3.7 1.4a12 12 0 0 0-7 0C6 1.6 4.8 2 4.8 2c-.4 1-.5 2.1-.3 3A4.8 4.8 0 0 0 3 9c0 4.8 3 5.8 5.8 6.2-.5.5-.8 1.3-.8 2.3" /></svg>
    <span>GitHub</span>
  </a>
  <a href={site.xiaohongshu} target="_blank" rel="noreferrer">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3h16v14H9l-5 4V3Z" /><path d="M8 7v6m4-6v6m4-6v6" /></svg>
    <span>{lang === 'en' ? 'Xiaohongshu' : '小红书'}</span>
  </a>
  <a href={`mailto:${site.email}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="1" /><path d="m3 5 9 8 9-8" /></svg>
    <span>{variant === 'full' ? site.email : lang === 'en' ? 'Email' : '邮箱'}</span>
  </a>
</nav>
